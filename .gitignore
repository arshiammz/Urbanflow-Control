# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment variables
.env

# Notebooks
.ipynb_checkpoints/

# Data and generated artifacts
data/raw/*
data/interim/*
data/processed/*
artifacts/
reports/**/*.json
mlruns/

# Keep directory structure in Git
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Keep small reproducible data-quality reports
!reports/data_quality/
!reports/data_quality/*-raw-audit.json
!reports/data_quality/*-validation-summary.json
!reports/data_quality/*-demand-aggregation.json
!reports/data_quality/*-forecast-features.json

# OS and editors
.DS_Store
.vscode/
.idea/

# Logs and temporary downloads
*.log
*.part